{
  "name": "md-technology/digital-cell",
  "description": "Aplicación PHP modular para MD Technology Digital Cell.",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist",
    "lint": "@php vendor/bin/phpcs --standard=PSR12 --warning-severity=0 --extensions=php app bootstrap config public routes tests",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress"
  }
}
