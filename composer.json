{
  "name": "md-technology/sistema-web-cell-sac",
  "description": "Sistema web de comercio para MD Technology Digital Cell",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.2",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --bootstrap tests/bootstrap.php tests",
    "lint": "@php bin/verificar_sintaxis.php",
    "analyse": "@php vendor/bin/phpstan analyse app --autoload-file=bootstrap/funciones.php --level=4 --no-progress",
    "style": "@php vendor/bin/phpcs --standard=PSR12 app tests"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
