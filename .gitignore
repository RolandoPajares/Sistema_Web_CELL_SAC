.env
/vendor/
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
# Product images are intentionally versioned so cloned repositories keep them.
!/public/uploads/
!/public/uploads/**
/.phpunit.cache/
/.phpunit.result.cache
*.tmp
